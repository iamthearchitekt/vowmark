DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="vowmark-dev-auth-secret-key-32-chars-long"

# OpenAI Configuration
OPENAI_API_KEY="sk-your-project-key"
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="gpt-image-2"

# Google Gemini Nano Banana Configuration
GOOGLE_GEMINI_API_KEY="AIzaSyMockGeminiKey"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-imagen"

# Storage Configuration
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="vowmark-assets"
STORAGE_ACCESS_KEY="mock-access-key"
STORAGE_SECRET_KEY="mock-secret-key"

# Stripe Payments Configuration
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_stripe_key"

# Font API
GOOGLE_FONTS_API_KEY="mock-google-fonts-key"

# Development / Mock Mode Switch
USE_MOCK_AI=true
